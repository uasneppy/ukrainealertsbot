# Copy to .env and fill in. Used by `docker compose` and local `npm start`.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Google Gemini API key — enables the "чому тривога" AI analysis (optional)
GEMINI_API_KEY=

# Timezone for log timestamps (optional, defaults to UTC). e.g. Europe/Kyiv
# TZ=Europe/Kyiv

# Street tiles for the city view (optional). Off by default — the map is
# self-contained (boundaries only) unless one of these is set. When set, city
# maps show streets under the threat markers, so you can see which street a
# threat is over.
#
# Recommended: a free Stadia Maps key (https://stadiamaps.com) — dark basemap
# that fits the alert map. Just the key is enough:
# STADIA_API_KEY=
#
# Or point at any {z}/{x}/{y} dark tile source (wins over STADIA_API_KEY):
# CITY_TILES_URL=https://tiles.example/dark/{z}/{x}/{y}.png
# CITY_TILES_ATTRIBUTION=© Provider · © OpenStreetMap
