# Copy to .env and fill in. Used by `docker compose` and local `npm start`.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Google Gemini API key — enables the "чому тривога" AI analysis (optional)
GEMINI_API_KEY=

# Timezone for log timestamps (optional, defaults to UTC). e.g. Europe/Kyiv
# TZ=Europe/Kyiv

# Live per-target notifications (missiles/ballistics/KABs) for subscribed
# regions. Defaults shown; leave unset to use them. Set LIVE_ALERT_TYPES=none to
# disable per-target alerts entirely and keep only тривога/відбій. (MiG-31K is
# a nationwide event — see EVENT_CHANNELS — not a per-region target.)
# LIVE_ALERT_TYPES=missile,ballistic,kab
# LIVE_ALERT_KM=120
# A regional advisory ("загроза балістики" over a city) is announced once, then
# stays silent this long however often the feed re-issues it.
# ADVISORY_QUIET_MS=1800000

# Nationwide events (strategic aviation take-off, MiG-31K / Kinzhal, Kalibr
# carriers and launches, drone launch counts) read from the monitoring-channel
# feed NEPTUN aggregates. Only these channels may trigger one; "all" trusts
# every channel in the feed, "none" disables the feature.
# EVENT_CHANNELS=@kpszsu,@rozvidkaneba,@ukrainian_intelligence
# EVENT_POLL_MS=20000
# EVENT_COOLDOWN_MS=1800000
# EVENT_UAV_COOLDOWN_MS=600000

# Watcher tuning (optional; code defaults shown). WATCHER_INTERVAL_MS is the
# safety-net poll; CONFIRM_OFF_MS is how long an all-clear must hold before
# "відбій" is announced — 0 announces it immediately.
# WATCHER_INTERVAL_MS=8000
# CONFIRM_OFF_MS=30000

# Street tiles for the city view (optional). Off by default — the map is
# self-contained (boundaries only) unless one of these is set. When set, city
# maps show streets under the threat markers, so you can see which street a
# threat is over.
#
# Recommended: a free Stadia Maps key (https://stadiamaps.com) — dark basemap
# that fits the alert map. Just the key is enough:
# STADIA_API_KEY=
#
# Or point at any {z}/{x}/{y} dark tile source (wins over STADIA_API_KEY):
# CITY_TILES_URL=https://tiles.example/dark/{z}/{x}/{y}.png
# CITY_TILES_ATTRIBUTION=© Provider · © OpenStreetMap
