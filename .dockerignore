# Dependencies — installed fresh inside the image
node_modules
npm-debug.log*

# Secrets — never bake these into an image
.env
.env.*

# Version control
.git
.gitignore

# GeoJSON cache — downloaded at runtime (see neptun/fetchGeo.js)
neptun/geo

# Tests & dev-only scripts — not needed in the production image
__tests__
scripts

# Replit-specific tooling / config
.replit
.local
.cache
.agents
.config
.upm
.breakpoints

# Docs
*.md

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
data
.github

# CasaOS packaging & docs — not needed in the runtime image
casaos
docs
